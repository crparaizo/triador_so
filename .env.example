# Configurações do sistema de triagem de OS industriais
# Copie este arquivo para .env e ajuste os valores conforme seu ambiente.
# NUNCA commite o arquivo .env — ele está no .gitignore

# =============================================================================
# LLM / Ollama
# =============================================================================

# Modelo Ollama a usar.
# Deve estar baixado localmente: ollama pull qwen3:0.6b
# O modelo padrão (qwen3:0.6b, ~500 MB) roda inteiramente em GPU mesmo com VRAM limitada.
# Se a sua infraestrutura tiver GPU com 4 GB+ de VRAM, modelos maiores oferecem
# melhor qualidade de extração: qwen3:1.7b (~1.5 GB), qwen3:4b (~2.7 GB).
OLLAMA_MODEL=qwen3:0.6b

# URL base do servidor Ollama.
# Altere se o Ollama estiver em outra porta ou máquina.
OLLAMA_BASE_URL=http://localhost:11434

# Temperatura de geração do LLM. 0.0 = praticamente determinístico.
# Recomendado manter 0.0 para reprodutibilidade da avaliação comparativa.
OLLAMA_TEMPERATURE=0.0

# Semente de geração do LLM. Fixá-la (com temperature=0) reduz a variação
# entre execuções e favorece a reprodutibilidade dos experimentos.
OLLAMA_SEED=42

# =============================================================================
# Comportamento
# =============================================================================

# Nível de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Número máximo de tentativas para chamadas LLM em caso de erro transitório.
MAX_RETRIES_LLM=3

# Timeout em segundos para cada chamada ao LLM.
# Aumente se o modelo for lento (máquinas sem GPU podem precisar de 120 s).
LLM_TIMEOUT_SECONDS=60

# Limite de tokens gerados por chamada ao LLM (inclui o raciocínio do qwen3).
# Com format="json", modelos pequenos podem entrar em laço repetindo chaves sem
# fechar o JSON; o limite encerra a geração e o caso vai para revisão humana.
OLLAMA_NUM_PREDICT=1024

# =============================================================================
# Diretórios
# =============================================================================

# Diretório com os arquivos YAML de ativos, equipes e categorias.
DATA_DIR=data

# Diretório onde os relatórios de avaliação são salvos.
RESULTS_DIR=results

# Diretório onde as sessões da interface Streamlit são persistidas.
SESSIONS_DIR=sessions
